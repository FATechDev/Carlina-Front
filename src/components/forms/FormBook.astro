---
import ReservationScript from '../ReservationScript.ts'
---

<form action="#" id="reservationForm" method="post">
	<div class="flex flex-col gap-8 mx-auto max-w-md">
		<div>
			<label for="name">Prénom</label>
			<div class="mt-2">
				<input type="text" name="name" id="name" required />
			</div>
		</div>

		<div>
			<label for="email">Email</label>
			<div class="mt-2 grid grid-cols-1">
				<input type="email" name="email" id="email" required />
			</div>
			<small class="italic text-gray-500">Un Email sera envoyé pour confirmer votre réservation</small>
		</div>

		<div>
			<label for="phone">Téléphone</label>
			<div class="mt-2">
				<input type="text" name="phone" id="phone" required />
			</div>
			<small class="italic text-gray-500">Un SMS sera envoyé pour confirmer votre réservation</small>
		</div>


		<div>
			<label for="date">Date de réservation</label>
			<input 
			  type="date" 
			  id="dateReservation" 
			  name="date" 
			  class="w-full p-3 rounded-lg border- border-white bg-[#157F71] text-white placeholder-white focus:outline-none focus:ring-2 focus:ring-white"
			  required 
			/>
			<p id="closedMessage" style="color: red; display: none;">Désolé, nous sommes fermés ce jour-là.</p>
		  </div>
		
		  <div id="creneauxContainer" style="display:none;" class="flex justify-between gap-2">
			<!-- Créneaux Midi -->
			<div class="w-1/2">
				<label for="creneauMidi">Créneaux Midi</label>
				<select id="creneauMidi" name="creneauMidi" class="w-full p-3 rounded-lg border-2 border-[#157F71] bg-[#157F71] text-white focus:outline-none focus:ring-2 focus:ring-white">
					<!-- Les créneaux midi seront ajoutés ici dynamiquement -->
				</select>
			</div>
		
			<!-- Créneaux Soir -->
			<div class="w-1/2">
				<label for="creneauSoir">Créneaux Soir</label>
				<select id="creneauSoir" name="creneauSoir" class="w-full p-3 rounded-lg border-2 border-[#157F71] bg-[#157F71] text-white focus:outline-none focus:ring-2 focus:ring-white">
					<!-- Les créneaux soir seront ajoutés ici dynamiquement -->
				</select>
			</div>
		</div>
		
		

		<!-- <div>
			<label for="date">Date & Time</label>
			<div class="mt-2">
				<input type="datetime-local" name="date" id="date" required />
			</div>
			<small class="italic text-gray-500"
				>Nous ne pouvons garantir la disponibilité à l'heure et à la date choisies.</small
			>
		</div> -->
		<div>
			<label for="nombre_personne">Nombre de personnes</label>
			<div class="mt-2">
				<input type="number" name="nombre_personne" id="nombre_personne" required />
			</div>
		</div>
		<div>
			<label for="message">Notes</label>
			<div class="mt-2">
				<textarea
					name="message"
					id="message"
					rows="4"
					required
					placeholder="Faites-nous savoir si vous avez des allergies ou si vous avez une table spécifique en tête"></textarea>
			</div>
		</div>

		<div>
			<button type="submit" class="button button-green group !px-8">
				<svg
					xmlns="http://www.w3.org/2000/svg"
					fill="none"
					viewBox="0 0 24 24"
					stroke-width="1.5"
					stroke="currentColor"
					class="size-5 -rotate-45 -mt-1 inline-block mr-1 group-hover:rotate-0 transition duration-300"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						d="M6 12 3.269 3.125A59.769 59.769 0 0 1 21.485 12 59.768 59.768 0 0 1 3.27 20.875L5.999 12Zm0 0h7.5"
					></path>
				</svg>
				Réservez
			</button>
		</div>
	</div>

	
</form>
<div id="confirmationMessage" class="text-brand-green text-center text-xl mt-6 opacity-0 transition-opacity duration-500">
	✅ Votre réservation a bien été confirmée. Merci !
  </div>
  
  
<ReservationScript client:load />
